<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- Every theme file merges Tokens itself: a StaticResource in a trigger or storyboard cannot see a sibling dictionary. -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Tokens.xaml" />
    </ResourceDictionary.MergedDictionaries>
    <sys:Boolean x:Key="Flag.On">True</sys:Boolean>

    <Style x:Key="Text.Label" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Text}" />
        <Setter Property="FontSize" Value="{StaticResource Type.Label}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
    </Style>
    <Style x:Key="Text.Version" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Numeral}" />
        <Setter Property="FontSize" Value="{StaticResource Type.Caption}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Tertiary}" />
    </Style>

    <!-- Tag follows the live system setting, so the triggers below can honor ClientAreaAnimation.
         The Setter holds the final state and the motion is a passing overlay, so without motion the state is still right. -->
    <Style x:Key="Button.Base" TargetType="Button">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontFamily" Value="{StaticResource Font.Text}" />
        <Setter Property="FontSize" Value="{StaticResource Type.Label}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
        <Setter Property="Tag" Value="{DynamicResource {x:Static SystemParameters.ClientAreaAnimationKey}}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Background="Transparent">
                        <Border x:Name="Glow" Margin="{StaticResource Space.Glow}" CornerRadius="{StaticResource Radius.Glow}" Background="{StaticResource Brush.Focus}" Visibility="Hidden" />
                        <Border x:Name="Hover" CornerRadius="{StaticResource Radius.Control}" Background="{StaticResource Brush.Hover}" Opacity="0" />
                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Hover" Property="Opacity" Value="1" /></Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="Tag" Value="{StaticResource Flag.On}" />
                            </MultiTrigger.Conditions>
                            <MultiTrigger.EnterActions>
                                <BeginStoryboard><Storyboard FillBehavior="Stop"><DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="{StaticResource Motion.Fast}" EasingFunction="{StaticResource Motion.Ease}" /></Storyboard></BeginStoryboard>
                            </MultiTrigger.EnterActions>
                            <MultiTrigger.ExitActions>
                                <BeginStoryboard><Storyboard FillBehavior="Stop"><DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" From="1" To="0" Duration="{StaticResource Motion.Fast}" EasingFunction="{StaticResource Motion.Ease}" /></Storyboard></BeginStoryboard>
                            </MultiTrigger.ExitActions>
                        </MultiTrigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="Hover" Property="Background" Value="{StaticResource Brush.Press}" /></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Glow" Property="Visibility" Value="Visible" /></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="{StaticResource Opacity.Disabled}" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Button.Icon" TargetType="Button" BasedOn="{StaticResource Button.Base}">
        <Setter Property="Width" Value="{StaticResource Size.IconButton}" />
        <Setter Property="Height" Value="{StaticResource Size.IconButton}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style x:Key="Button.Menu" TargetType="Button" BasedOn="{StaticResource Button.Base}">
        <Setter Property="Padding" Value="{StaticResource Space.MenuItem}" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
    </Style>

    <!-- Switch: the whole row is the control. Ui/Switch.cs moves the knob named here; a CheckBox would simply not animate. -->
    <Style x:Key="Control.Switch" TargetType="CheckBox">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <DockPanel Background="Transparent">
                        <Grid DockPanel.Dock="Right" Width="{StaticResource Size.SwitchWidth}" Height="{StaticResource Size.SwitchHeight}">
                            <Border x:Name="Glow" Margin="{StaticResource Space.Glow}" CornerRadius="{StaticResource Radius.SwitchGlow}" Background="{StaticResource Brush.Focus}" Visibility="Hidden" />
                            <Border x:Name="Pill" CornerRadius="{StaticResource Radius.Switch}" Background="{StaticResource Brush.Track}" />
                            <Ellipse x:Name="Knob" Width="{StaticResource Size.SwitchKnob}" Height="{StaticResource Size.SwitchKnob}" Margin="{StaticResource Space.KnobInset}" HorizontalAlignment="Left" Fill="{StaticResource Brush.Knob}" Effect="{StaticResource Elevation.Knob}" />
                        </Grid>
                        <ContentPresenter VerticalAlignment="Center" />
                    </DockPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Pill" Property="Background" Value="{StaticResource Brush.Accent}" />
                            <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Glow" Property="Visibility" Value="Visible" /></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="{StaticResource Opacity.Disabled}" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
