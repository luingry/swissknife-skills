<Window x:Class="__APP__.Ui.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:__APP__.Ui"
        Title="__APP__" Width="{StaticResource Size.SettingsWidth}" SizeToContent="Height" WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        UseLayoutRounding="True" TextOptions.TextRenderingMode="Grayscale" TextOptions.TextFormattingMode="Ideal">
    <Grid Margin="{StaticResource Space.ShadowRoom}">
        <Border CornerRadius="{StaticResource Radius.Panel}" Background="{StaticResource Brush.Surface}" Effect="{StaticResource Elevation.Panel}" />
        <StackPanel Margin="{StaticResource Space.Panel}">
            <Image x:Name="AppIcon" Width="{StaticResource Size.AppIcon}" Height="{StaticResource Size.AppIcon}" AutomationProperties.Name="__APP__" />
            <TextBlock x:Name="VersionText" Style="{StaticResource Text.Version}" HorizontalAlignment="Center" Margin="{StaticResource Space.IconGap}" />
            <ui:Switch x:Name="StartupToggle" Style="{StaticResource Control.Switch}" AutomationProperties.Name="Iniciar com o Windows">
                <TextBlock Style="{StaticResource Text.Label}" Text="Iniciar com o Windows" />
            </ui:Switch>
        </StackPanel>
        <Button Style="{StaticResource Button.Icon}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="{StaticResource Space.CloseButton}"
                Click="OnCloseClicked" AutomationProperties.Name="Fechar" IsCancel="True">
            <Path Data="{StaticResource Icon.Close}" Stroke="{StaticResource Brush.Text.Secondary}" StrokeThickness="{StaticResource Size.IconStroke}" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
        </Button>
    </Grid>
</Window>
