<Window x:Class="__APP__.Ui.TrayMenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="__APP__" SizeToContent="WidthAndHeight" ShowInTaskbar="False" Topmost="True"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        UseLayoutRounding="True" TextOptions.TextRenderingMode="Grayscale" TextOptions.TextFormattingMode="Ideal">
    <Grid Margin="{StaticResource Space.ShadowRoom}" MinWidth="{StaticResource Size.MenuMinWidth}">
        <Border CornerRadius="{StaticResource Radius.Menu}" Background="{StaticResource Brush.Surface.Raised}" Effect="{StaticResource Elevation.Panel}" />
        <StackPanel Margin="{StaticResource Space.MenuPanel}">
            <Button Style="{StaticResource Button.Menu}" Content="Configurações" Click="OnSettingsClicked" />
            <Button Style="{StaticResource Button.Menu}" Content="Sair" Click="OnQuitClicked" />
        </StackPanel>
    </Grid>
</Window>
